# ============================================
# AI Design SaaS - Environment Variables
# ============================================
# Copy this file to .env.local and fill in the values

# ============================================
# Supabase Configuration
# ============================================
# Get these from: https://app.supabase.com/project/_/settings/api

# Public URL (safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anonymous Key (safe to expose, used for client-side auth)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key (NEVER expose to browser!)
# Used only for server-side operations
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# Google Gemini API
# ============================================
# Get your API key from: https://aistudio.google.com/app/apikey

GEMINI_API_KEY=AIza...

# ============================================
# Application URLs
# ============================================
# Your application's public URL (without trailing slash)

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production example:
# NEXT_PUBLIC_APP_URL=https://app.aidesign.ru

# ============================================
# Payments (Optional - for billing)
# ============================================
# YooKassa (Russian payment system)
# Get credentials from: https://yookassa.ru/

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# OR Stripe (International)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================
# Email Notifications (Optional)
# ============================================
# Resend: https://resend.com/

RESEND_API_KEY=re_...

# OR Postmark
# POSTMARK_API_KEY=

# From email address
EMAIL_FROM=noreply@aidesign.ru

# ============================================
# Analytics & Monitoring (Optional)
# ============================================
# Sentry for error tracking
# SENTRY_DSN=https://...@sentry.io/...

# Vercel Analytics (auto-configured on Vercel)
# No env needed

# ============================================
# Development Settings
# ============================================
# Set to 'true' to enable debug mode
DEBUG=false

# Skip API rate limiting in development
SKIP_RATE_LIMIT=false
